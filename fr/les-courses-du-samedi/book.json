  "title": "Le chariot qui grince",
  "topic": {
    "type": "theme",
    "name": "Faire les courses au supermarché"
  },
  "summary": "Gaston part faire des courses simples un samedi matin : douze articles, vingt minutes, pas une de plus. Mais son chariot a une roue capricieuse, et tout le supermarché semble avoir décidé de se mettre en travers de sa liste.",
  "characters": [
    {
      "name": "Gaston Pichon",
      "description": "Protagonist, 52, a fussy, proud bachelor accountant from Tours who lives by lists and schedules. Wants to do his weekly shop in twenty minutes flat to host a dinner for his new neighbour. Flaw: stubborn pride and bad at saying no to tempting offers (impulse buyer)."
    },
    {
      "name": "Madame Odette Roux",
      "description": "78, his neighbour from the flat below, sharp-tongued and kind, a shopping expert who knows every promotion, coupon and trick. Ends up joining his shopping trip and the dinner."
    },
    {
      "name": "Josiane",
      "description": "Cashier in her fifties at the supermarket, calm, dry humour, has seen everything. Always says 'Merci, bonne journée !' no matter what happens."
    },
    {
      "name": "Monsieur Lemoine",
      "description": "The store manager, young, anxious, over-polite, always saying 'Veuillez patienter, un instant', chased around by small disasters."
    },
    {
      "name": "Kévin",
      "description": "Early-twenties shop assistant who restocks shelves and works the deli and bakery counters, laid-back and helpful, often cheerfully out of stock of everything."
    }
  ],
  "levels": [
    "A1",
    "A2",
    "B1",
    "B2",
    "C1"
  ],
  "chapters": [
    {
      "number": 1,
      "title": "Vingt minutes, pas une de plus",
      "period": "Saturday morning, the car park and entrance of a big supermarket outside Tours",
      "summary": "Gaston arrives with a precise shopping list for a dinner he is hosting, convinced he'll be out in twenty minutes. He fights for a trolley in the car park, ends up with one that has a squeaking, rebellious wheel, and meets his neighbour Madame Roux at the entrance, who eyes his list with pity. The wheel pulls left, and so does his plan.",
      "key_facts": [
        {
          "claim": "In French supermarkets, trolleys are usually unlocked with a one-euro coin or a token that you get back when you return the trolley."
        },
        {
          "claim": "Large French supermarkets (hypermarchés, grandes surfaces) are usually on the outskirts of towns, with a big car park and an entrance and exit on separate sides."
        },
        {
          "claim": "Many French shops require customers to bring their own bags: single-use plastic checkout bags have been banned in France since 2016, so people use reusable bags."
        },
        {
          "claim": "Supermarkets in France are often closed on Sunday afternoon and sometimes all day Sunday, which is why Saturday morning is a busy shopping time."
        },
        {
          "claim": "Many supermarkets also offer a drive (click-and-collect), where you order online and collect the shopping from your car."
        }
      ],
