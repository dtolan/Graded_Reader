{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoryTime book",
  "description": "stories/<lang>/<book-id>/book.json. Level-independent: the factual backbone shared by every level.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "language",
    "genre",
    "visibility",
    "status",
    "title",
    "topic",
    "summary",
    "levels",
    "chapters"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "language": {
      "type": "string",
      "enum": [
        "fr"
      ]
    },
    "genre": {
      "type": "string",
      "enum": [
        "history",
        "fiction",
        "scifi"
      ],
      "description": "history is true and checked against key_facts. fiction and scifi are invented stories set in real France; their key_facts are true real-world details (places, food, customs, activities), not plot."
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed"
      ],
      "description": "Stays draft until a human has checked every key_facts entry"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "object",
      "required": [
        "type",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "person",
            "event",
            "place",
            "theme"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "description": "e.g. '1412-1431'"
        },
        "region": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Short French blurb for the catalog"
    },
    "characters": {
      "type": "array",
      "description": "Fiction and scifi only: the invented cast, kept consistent across chapters and levels",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "levels": {
      "type": "array",
      "description": "CEFR levels for which chapter files exist",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/level"
      }
    },
    "chapters": {
      "type": "array",
      "description": "The backbone: ordered chapter plan, identical across levels",
      "minItems": 10,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "number",
          "title",
          "summary",
          "key_facts"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "What this chapter covers; also the continuity summary passed to the next chapter"
          },
          "key_facts": {
            "type": "array",
            "minItems": 1,
            "description": "Verifiable claims this chapter may make. Generated levels must not go beyond these.",
            "items": {
              "type": "object",
              "required": [
                "claim"
              ],
              "additionalProperties": false,
              "properties": {
                "year": {
                  "type": "string"
                },
                "claim": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "generated": {
      "$ref": "#/$defs/generated"
    },
    "review": {
      "type": "object",
      "description": "Set by tools/review_book.py approve when a human has signed the book off",
      "required": [
        "by",
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ]
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      }
    }
  }
}
