{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoryTime story",
  "type": "object",
  "required": ["id", "language", "level", "title", "topic", "summary", "sections", "vocabulary", "key_facts", "questions", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "language": { "type": "string", "enum": ["fr"] },
    "level": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C1"], "description": "CEFR reading level" },
    "title": { "type": "string" },
    "topic": {
      "type": "object",
      "required": ["type", "name"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["person", "event", "place"] },
        "name": { "type": "string" },
        "period": { "type": "string", "description": "e.g. '1412-1431'" },
        "region": { "type": "string" }
      }
    },
    "summary": { "type": "string", "description": "One or two sentences, in the story's language and level" },
    "sections": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "required": ["heading", "text"], "additionalProperties": false,
        "properties": { "heading": { "type": "string" }, "text": { "type": "string" } }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object", "required": ["term", "pos", "gloss_en"], "additionalProperties": false,
        "properties": { "term": { "type": "string" }, "pos": { "type": "string" }, "gloss_en": { "type": "string" } }
      }
    },
    "key_facts": {
      "type": "array",
      "description": "Verifiable factual claims made in the story, for human review",
      "items": {
        "type": "object", "required": ["claim"], "additionalProperties": false,
        "properties": { "year": { "type": "string" }, "claim": { "type": "string" } }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["question", "answer"], "additionalProperties": false,
        "properties": { "question": { "type": "string" }, "answer": { "type": "string" } }
      }
    },
    "status": { "type": "string", "enum": ["draft", "reviewed"], "description": "Generated stories start as draft until a human checks key_facts" },
    "generated": {
      "type": "object", "additionalProperties": false,
      "properties": { "model": { "type": "string" }, "date": { "type": "string" } }
    }
  }
}
